# Same project used by mercado_invest. These values are SERVER ONLY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Required to read live data. Use a long, unique password (at least 4 characters).
ATLAS_ACCESS_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATLAS_SESSION_SECRET=
# Optional: maximum age of quotes in seconds. Same default as backend reference age.
ATLAS_QUOTE_MAX_AGE_SECONDS=345600
# Individual Auth and /virtual only. Modern sb_publishable_ key; never put an admin key here.
# Kept server-only with the user JWT. Independent from shared operator access above.
SUPABASE_PUBLISHABLE_KEY=
