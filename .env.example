# Same project used by mercado_invest. These values are SERVER ONLY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Required to read live data. Use a long, unique password (at least 12 characters).
ATLAS_ACCESS_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATLAS_SESSION_SECRET=
# Optional: maximum age of quotes in seconds. Same default as backend reference age.
ATLAS_QUOTE_MAX_AGE_SECONDS=345600
